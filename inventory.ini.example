# Generated by `scripts/vms.sh inventory`; this is only the shape.
[bastion_servers]
bastion ansible_host=192.0.2.10

[private_servers]
private ansible_host=192.0.2.11

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=.vm-state/known_hosts'

[private_servers:vars]
# The private server is only reachable by jumping through the bastion.
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=.vm-state/known_hosts -o ProxyCommand="ssh -W %h:%p -q -i .keys/fortress_ed25519 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=.vm-state/known_hosts ubuntu@192.0.2.10"'
