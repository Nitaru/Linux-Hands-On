---
extends: default
rules:
  line-length: disable          # long shell one-liners and descriptions are clearer unwrapped
  braces: { max-spaces-inside: 4 }   # inline role lists in setup.yml are aligned on purpose
  commas: disable
  comments: { min-spaces-from-content: 1 }   # Dependabot writes the version after a pinned SHA as "@sha # v4"
  truthy: { allowed-values: ["true", "false"], check-keys: false }
ignore: |
  .keys/
  .vm-state/
